# UrbanPulse Environment Variables
# Copy to .env and fill in real values

ENV=dev
DATABASE_URL=postgresql://localhost:5432/urbanpulse

# Supabase Auth & Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
DATA_GOV_IN_API_KEY=

# Google Air Quality API key (for live Bengaluru AQI — server-side only, never sent to browser)
# Get key at: https://console.cloud.google.com/apis/library/airquality.googleapis.com
GOOGLE_AQI_API_KEY=

# UrbanPulse Intelligence Assistant & Semantic Cache
# Ollama local AI server
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_PRIMARY_MODEL=qwen3:8b
# OLLAMA_FALLBACK_MODEL=mistral   # uncomment after: ollama pull mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60

# Redis Persistent Semantic Vector Cache (Optional — graceful fallback if offline)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL=86400
REDIS_SIMILARITY_THRESHOLD=0.90
