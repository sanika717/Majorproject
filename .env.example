# UrbanPulse — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
ENV=dev

# ─── Database ─────────────────────────────────────────────────────────────────
# Local (without Docker):
DATABASE_URL=postgresql://localhost:5432/urbanpulse
# With Docker Compose (docker-compose.yml reads POSTGRES_* and builds DATABASE_URL itself):
POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=changeme_strong_password

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Found in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# ─── Ollama (AI Assistant) ────────────────────────────────────────────────────
# Local run:    http://127.0.0.1:11434
# Docker Compose: http://host.docker.internal:11434  (Ollama runs on host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_PRIMARY_MODEL=qwen3:4b
# OLLAMA_FALLBACK_MODEL=mistral   # uncomment after: ollama pull mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30

# ─── Redis Semantic Cache (optional — graceful fallback if offline) ────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL=86400
REDIS_SIMILARITY_THRESHOLD=0.90

# ─── External APIs (optional) ─────────────────────────────────────────────────
# Google Air Quality API — live Bengaluru AQI (server-side only)
# https://console.cloud.google.com/apis/library/airquality.googleapis.com
GOOGLE_AQI_API_KEY=
DATA_GOV_IN_API_KEY=
